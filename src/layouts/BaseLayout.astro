---
import '../styles/global.css';
import { SITE_URL } from '../lib/github';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'Semper',
  description = 'Semper measures how objects deform — full-field displacement and strain from photographs, on Android.',
  path = '/',
} = Astro.props;

const pageTitle = title === 'Semper' ? 'Semper — Digital Image Correlation' : `${title} · Semper`;
const canonical = new URL(path, SITE_URL).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0e1412" />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">Semper<span>.</span></a>
        <nav class="nav" aria-label="Primary">
          <a href="/download" aria-current={path === '/download' ? 'page' : undefined}>Download</a>
          <a href="/community" aria-current={path.startsWith('/community') ? 'page' : undefined}
            >Community</a
          >
          <a href="/bugs" aria-current={path === '/bugs' ? 'page' : undefined}>Bugs</a>
          <a href="/features" aria-current={path === '/features' ? 'page' : undefined}>Features</a>
          <a href="/support" aria-current={path === '/support' ? 'page' : undefined}>Support</a>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <span>Semper DIC · semperdic.com</span>
        <span>
          <a href="https://github.com/semperdic/website">GitHub</a>
          ·
          <a href="/support">Support</a>
        </span>
      </footer>
    </div>
  </body>
</html>
