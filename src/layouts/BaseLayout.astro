---
import '../styles/global.css';
import { SITE_URL, SUPPORT_EMAIL, githubRepoUrl, withBase } from '../lib/github';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const {
  title = 'Semper',
  description = 'Semper measures how objects deform — full-field displacement and strain from photographs, on Android.',
  path = '/',
} = Astro.props;

const pageTitle = title === 'Semper' ? 'Semper — Digital Image Correlation' : `${title} · Semper`;
const canonicalPath = path.endsWith('/') || path === '/' ? path : `${path}/`;
const canonical = new URL(canonicalPath.replace(/^\//, ''), `${SITE_URL}/`).toString();
const iconHref = withBase('/brand/semper-icon.webp');
const mail = `mailto:${SUPPORT_EMAIL}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/webp" href={iconHref} />
    <link rel="apple-touch-icon" href={iconHref} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={new URL('brand/semper-icon.webp', `${SITE_URL}/`).toString()} />
    <meta name="theme-color" content="#0288D1" />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href={withBase('/')}>
          <img
            class="brand-mark"
            src={withBase('/brand/semper-mark.webp')}
            width="36"
            height="36"
            alt=""
          />
          Semper
        </a>
        <nav class="nav" aria-label="Primary">
          <a href={withBase('/download')} aria-current={path === '/download' ? 'page' : undefined}
            >Download</a
          >
          <a
            href={withBase('/manual')}
            aria-current={path.startsWith('/manual') ? 'page' : undefined}>Manual</a
          >
          <a
            href={withBase('/community')}
            aria-current={path.startsWith('/community') || path === '/bugs' || path === '/features'
              ? 'page'
              : undefined}>Community</a
          >
          <a href={withBase('/support')} aria-current={path === '/support' ? 'page' : undefined}
            >Support</a
          >
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-cols">
          <div>
            <h3>Product</h3>
            <ul>
              <li><a href={withBase('/download')}>Download</a></li>
              <li><a href={withBase('/manual')}>Manual</a></li>
              <li><a href={withBase('/community')}>Community</a></li>
              <li><a href={withBase('/support')}>Support</a></li>
            </ul>
          </div>
          <div>
            <h3>Learn</h3>
            <ul>
              <li><a href={withBase('/learn/dic')}>How DIC works</a></li>
              <li><a href={withBase('/learn/glossary')}>Glossary</a></li>
              <li><a href={withBase('/learn/parameters')}>Parameters</a></li>
              <li><a href={withBase('/manual/faq')}>FAQ</a></li>
            </ul>
          </div>
          <div>
            <h3>Community</h3>
            <ul>
              <li><a href={withBase('/bugs')}>Report a bug</a></li>
              <li><a href={withBase('/features')}>Request a feature</a></li>
              <li><a href={withBase('/community/q-a')}>Discussions · Q&amp;A</a></li>
              <li><a href={`${githubRepoUrl}/issues`}>All issues on GitHub</a></li>
            </ul>
          </div>
          <div>
            <h3>Project</h3>
            <ul>
              <li><a href={githubRepoUrl}>GitHub</a></li>
              <li><a href={withBase('/privacy')}>Privacy</a></li>
              <li><a href={`${githubRepoUrl}/blob/main/CODE_OF_CONDUCT.md`}>Code of conduct</a></li>
              <li><a href={mail}>{SUPPORT_EMAIL}</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">Semper · Digital Image Correlation on Android</p>
      </footer>
    </div>
  </body>
</html>
