---
interface Props {
  name: 'qa' | 'ideas' | 'announce' | 'general' | 'bug' | 'feature';
}

const { name } = Astro.props;
---

<span class="hub-icon" aria-hidden="true">
  {
    name === 'qa' && (
      <svg viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="9" />
        <path d="M9.5 9.5a2.5 2.5 0 0 1 4.6 1c0 1.5-2.1 2-2.1 3.5" />
        <circle cx="12" cy="17" r="0.8" fill="currentColor" stroke="none" />
      </svg>
    )
  }
  {
    name === 'ideas' && (
      <svg viewBox="0 0 24 24">
        <path d="M9 18h6" />
        <path d="M10 21h4" />
        <path d="M12 3a6 6 0 0 1 3.5 10.7c-.7.5-1.1 1.2-1.2 2.3H9.7c-.1-1.1-.5-1.8-1.2-2.3A6 6 0 0 1 12 3z" />
      </svg>
    )
  }
  {
    name === 'announce' && (
      <svg viewBox="0 0 24 24">
        <path d="M3 11v2a2 2 0 0 0 2 2h1l6 4V5L6 9H5a2 2 0 0 0-2 2z" />
        <path d="M16 8.5a4.5 4.5 0 0 1 0 7" />
        <path d="M18.5 6a8 8 0 0 1 0 12" />
      </svg>
    )
  }
  {
    name === 'general' && (
      <svg viewBox="0 0 24 24">
        <path d="M21 15a3 3 0 0 1-3 3H8l-4 3V6a3 3 0 0 1 3-3h11a3 3 0 0 1 3 3z" />
      </svg>
    )
  }
  {
    name === 'bug' && (
      <svg viewBox="0 0 24 24">
        <path d="M8 9h8v6a4 4 0 0 1-8 0z" />
        <path d="M12 9V5" />
        <path d="M9 5h6" />
        <path d="M5 12H3M21 12h-2M6 8l-2-2M18 8l2-2M6 16l-2 2M18 16l2 2" />
      </svg>
    )
  }
  {
    name === 'feature' && (
      <svg viewBox="0 0 24 24">
        <path d="M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z" />
        <path d="M18 15l.9 2.6L21.5 18.5l-2.6.9L18 22l-.9-2.6-2.6-.9 2.6-.9z" />
      </svg>
    )
  }
</span>
