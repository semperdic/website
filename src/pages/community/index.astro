---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HubIcon from '../../components/HubIcon.astro';
import {
  discussionNewUrl,
  githubRepoUrl,
  issueNewUrl,
  withBase,
} from '../../lib/github';

const hubs = [
  {
    icon: 'qa' as const,
    title: 'Discussions · Q&A',
    blurb: 'How-to questions and troubleshooting.',
    openHref: withBase('/community/q-a'),
    newHref: discussionNewUrl('q-a'),
  },
  {
    icon: 'ideas' as const,
    title: 'Ideas',
    blurb: 'Brainstorm before filing a formal feature request.',
    openHref: withBase('/community/ideas'),
    newHref: discussionNewUrl('ideas'),
  },
  {
    icon: 'announce' as const,
    title: 'Announcements',
    blurb: 'Release notes and product news from the Semper team.',
    openHref: withBase('/community/announcements'),
    newHref: null as string | null,
    viewHref: discussionNewUrl('announcements'),
  },
  {
    icon: 'general' as const,
    title: 'General',
    blurb: 'Everything else about Semper and DIC workflows.',
    openHref: withBase('/community/general'),
    newHref: discussionNewUrl('general'),
  },
  {
    icon: 'bug' as const,
    title: 'Report a bug',
    blurb: 'Something broke or produced wrong results.',
    openHref: withBase('/bugs'),
    newHref: issueNewUrl('bug_report.yml'),
  },
  {
    icon: 'feature' as const,
    title: 'Request a feature',
    blurb: 'Suggest an improvement (GitHub Issues).',
    openHref: withBase('/features'),
    newHref: issueNewUrl('feature_request.yml'),
  },
];
---

<BaseLayout
  title="Community"
  description="Discussions, bugs, and feature requests for Semper."
  path="/community"
>
  <section class="section" style="padding-top: 3rem">
    <h2>Community</h2>
    <p class="sub">
      Browse on this site; posting uses your GitHub account on
      <a href={githubRepoUrl}>{githubRepoUrl.replace('https://', '')}</a>. For how-to guides,
      <a href={withBase('/manual')}>Open Manual</a>.
    </p>

    <div class="hub-grid">
      {
        hubs.map((h) => (
          <div class="hub-card">
            <HubIcon name={h.icon} />
            <div class="hub-body">
              <h3>{h.title}</h3>
              <p>{h.blurb}</p>
              <div class="hub-actions">
                <a class="btn btn-primary" href={h.openHref}>
                  Open
                </a>
                {h.newHref ? (
                  <a class="btn btn-ghost" href={h.newHref} rel="noopener noreferrer">
                    Start new
                  </a>
                ) : (
                  <a class="btn btn-ghost" href={h.viewHref!} rel="noopener noreferrer">
                    View on GitHub
                  </a>
                )}
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <p style="margin-top: 1.75rem">
      <a href={`${githubRepoUrl}/issues`}>View on GitHub · issues</a>
      {' · '}
      <a href={`${githubRepoUrl}/discussions`}>View on GitHub · discussions</a>
    </p>
  </section>
</BaseLayout>
