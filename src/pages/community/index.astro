---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  discussionNewUrl,
  githubRepoUrl,
  issueNewUrl,
  withBase,
} from '../../lib/github';

const hubs = [
  {
    title: 'Discussions · Q&A',
    blurb: 'How-to questions and troubleshooting. GitHub login required to post.',
    primary: { href: withBase('/community/q-a'), label: 'Browse Q&A' },
    secondary: { href: discussionNewUrl('q-a'), label: 'New question', external: true },
  },
  {
    title: 'Ideas',
    blurb: 'Brainstorm improvements before filing a formal feature request.',
    primary: { href: withBase('/community/ideas'), label: 'Browse ideas' },
    secondary: { href: discussionNewUrl('ideas'), label: 'New idea', external: true },
  },
  {
    title: 'Announcements',
    blurb: 'Release notes and product news from the Semper team.',
    primary: { href: withBase('/community/announcements'), label: 'Browse' },
    secondary: { href: discussionNewUrl('announcements'), label: 'On GitHub', external: true },
  },
  {
    title: 'General',
    blurb: 'Everything else about Semper and DIC workflows.',
    primary: { href: withBase('/community/general'), label: 'Browse' },
    secondary: { href: discussionNewUrl('general'), label: 'New discussion', external: true },
  },
  {
    title: 'Report a bug',
    blurb: 'Something broke or produced wrong results — tracked as GitHub Issues.',
    primary: { href: withBase('/bugs'), label: 'Open bugs' },
    secondary: { href: issueNewUrl('bug_report.yml'), label: 'New bug', external: true },
  },
  {
    title: 'Request a feature',
    blurb: 'Suggest an improvement — tracked as Issues labeled enhancement.',
    primary: { href: withBase('/features'), label: 'Open requests' },
    secondary: { href: issueNewUrl('feature_request.yml'), label: 'New request', external: true },
  },
];
---

<BaseLayout
  title="Community"
  description="Discussions, bugs, and feature requests for Semper."
  path="/community"
>
  <section class="section" style="padding-top: 3rem">
    <h2>Community</h2>
    <p class="sub">
      Browse here; posting uses your GitHub account on
      <a href={githubRepoUrl}>{githubRepoUrl.replace('https://', '')}</a>. For how-to guides, see
      the <a href={withBase('/manual')}>Manual</a>.
    </p>

    <div class="hub-grid">
      {
        hubs.map((h) => (
          <div class="hub-card">
            <h3>{h.title}</h3>
            <p>{h.blurb}</p>
            <div class="hub-actions">
              <a class="btn btn-primary" href={h.primary.href}>
                {h.primary.label}
              </a>
              <a
                class="btn btn-ghost"
                href={h.secondary.href}
                rel={h.secondary.external ? 'noopener noreferrer' : undefined}
              >
                {h.secondary.label}
              </a>
            </div>
          </div>
        ))
      }
    </div>

    <p style="margin-top: 1.75rem">
      <a href={`${githubRepoUrl}/issues`}>All open issues on GitHub →</a>
      {' · '}
      <a href={`${githubRepoUrl}/discussions`}>All discussions →</a>
    </p>
  </section>
</BaseLayout>
