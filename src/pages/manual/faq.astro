---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManualPager from '../../components/ManualPager.astro';
import { withBase } from '../../lib/github';

const idics = 'https://idics.org/guide/';

// Conceptual "what / why" questions only. Anything of the form "X broke, what do
// I do" lives on /support/troubleshooting, keyed by the on-screen message.
const faqs = [
  {
    q: 'What is Semper for?',
    a: 'It measures how a surface deforms from photographs — full-field displacement and strain maps, computed on your Android phone. It is aimed at mechanical testing and materials work.',
  },
  {
    q: 'Is it free, and do I need an account?',
    a: 'You sign in (Google or email), and a new account needs a one-time admin approval before you can use the app. That gate is about managing access, not payment.',
  },
  {
    q: 'Why does my account need approval?',
    a: 'Semper is an allow-list app while it is in early release. Support is emailed automatically when you sign up; tap Check status in the app after you are approved — it does not update on its own.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, once your device has been approved. Importing frames and running the correlation need no network. Only sign-in, approval checks, and cloud uploads do.',
  },
  {
    q: 'Can I use my phone camera, or a video?',
    a: 'You load photos you have already taken, or pick a video and Semper samples it into frames (the first frame becomes the reference). For how to shoot a good speckle and lighting, see the iDICs guide below.',
  },
  {
    q: 'Are results in millimetres?',
    a: 'No. Displacements are in pixels — Semper has no spatial calibration. Convert with your own scale factor (pixels per mm from your setup).',
  },
  {
    q: 'How accurate is it?',
    a: 'The engine locates each subset to roughly 1/100 of a pixel, and recommends a subset size that targets about 0.007 px displacement accuracy on your image. Real accuracy depends on your speckle, lighting, and camera — the parameters and a sweep let you check it.',
  },
  {
    q: 'Is my data uploaded to the cloud?',
    a: 'Only if you turn on Save to cloud. The correlation always runs on the phone; cloud backup just stores the results you choose to sync, so you can restore them. See Privacy for the full picture.',
  },
  {
    q: 'Can I use Semper results in a paper?',
    a: 'Yes. Export “Everything”, quote the VSG with any strain value, and keep the archive with your raw images — inputs, fields, and parameters together are what make the result reproducible.',
  },
  {
    q: 'Something went wrong — where do I look?',
    a: 'Troubleshooting is indexed by the exact message the app showed you. For how-to, use the Manual; for account or private matters, email support.',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Common Semper questions about images, ROI, strain, and support."
  path="/manual/faq"
>
  <section class="section" style="padding-top: 3rem">
    <p class="crumb">
      <a href={withBase('/manual')}>← Manual</a>
    </p>
    <h2>FAQ</h2>
    <p class="sub">
      Short answers to the questions people arrive with. Hit an actual error or a “why did it do
      that”? That lives in <a href={withBase('/support/troubleshooting')}>Troubleshooting</a>.
    </p>

    <div class="faq">
      {
        faqs.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>

    <div class="faq-note">
      <p>
        Speckle, lighting, and experiment design are outside this FAQ. See the iDICs
        <a href={idics} rel="noopener noreferrer"
          ><em>Good Practices Guide for Digital Image Correlation</em></a
        >, or the
        <a href={withBase('/manual')}>Manual</a> and
        <a href={withBase('/learn/dic')}>How DIC works</a>.
      </p>
    </div>

    <p class="sub" style="margin-top: 1.25rem">
      <a href={withBase('/support/troubleshooting')}>Troubleshooting</a>
      ·
      <a href={withBase('/privacy')}>Privacy</a>
      ·
      <a href={withBase('/community')}>Community</a>
      ·
      <a href={withBase('/support')}>Support</a>
    </p>

    <ManualPager prev={{ href: '/manual/exports-manage', label: 'Exports & manage' }} />
  </section>
</BaseLayout>
