---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/github';

const idics = 'https://idics.org/guide/';

const faqs = [
  {
    q: 'Why did I get a low-texture / weak speckle warning?',
    a: 'In the app: on import Semper measures intensity gradients in your reference. A weak pattern triggers a warning and suggests a larger subset. Treat that as feedback on the pattern, not only a slider tip.',
    practice:
      'Aim for high-contrast, random, well-resolved speckle with enough features inside each subset. Improve paint and lighting before forcing very small subsets.',
  },
  {
    q: 'Frames are different sizes, or JPEG looks soft — what breaks?',
    a: 'In the app: all frames must match the reference pixel size or the run is blocked. JPEG works but Semper warns because compression damages gradients. Prefer PNG or TIFF; use Files for RAW/DNG.',
    practice:
      'Keep acquisition settings fixed across the sequence, avoid aggressive compression, and keep lighting stable so intensity changes come from deformation, not the camera pipeline.',
  },
  {
    q: 'ROI too small, or correlation fails on grips / fiducials?',
    a: 'In the app: an ROI smaller than the subset will not run — enlarge the ROI or shrink the subset. Use Erase to punch out grips and markers that will decorrelate.',
    practice:
      'Correlate only on well-speckled material. Exclude regions that leave the field of view, lose focus, or leave the plane of the camera.',
  },
  {
    q: 'The run stopped mid-sequence (“decorrelated”). Is the data lost?',
    a: 'In the app: two consecutive frames below 50% convergence stop the run. Frames solved before that are kept, with the stop reason on Home and in Settings used.',
    practice:
      'Large strain, glare, or pattern damage between frames causes decorrelation. Reduce the load step, improve lighting, or split the test with intermediate references when appropriate.',
  },
  {
    q: 'Strain looks noisy — or peaks look washed out?',
    a: 'In the app: raise the strain window (and quote VSG) to smooth noise; lower it to keep local peaks. Use a Sweep to see where curves stop separating.',
    practice:
      'Report the virtual strain gauge size with strain maps, and show that results are stable across reasonable VSG choices (a sensitivity check).',
  },
  {
    q: 'Are U and V in millimetres?',
    a: 'In the app: no. Displacements are in pixels. Semper has no spatial calibration — convert with your own scale factor.',
    practice:
      'Document how you convert pixels to physical units, and keep that scale consistent across the study.',
  },
  {
    q: 'Frames look incomparable in the viewer, or order is wrong?',
    a: 'In the app: Auto colour scale rescales each frame alone — set fixed min/max, or use the summary animation (one scale for the sequence). Fix order with Sort on step 1 before Compute.',
    practice:
      'When reporting a sequence, compare load steps on a common colour scale.',
  },
  {
    q: 'Where do I ask for help?',
    a: 'In the app / site: use the Manual for how-to. For open questions, bugs, and features, open Community (GitHub login required to post). For account or private data, use Support email.',
    practice:
      'When reporting a problem, include app version, device, image format/resolution, and exports (PDF/CSV) if results look wrong.',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Common DIC and Semper questions with good-practice notes."
  path="/manual/faq"
>
  <section class="section" style="padding-top: 3rem">
    <p class="crumb">
      <a href={withBase('/manual')}>← Manual</a>
    </p>
    <h2>FAQ</h2>
    <p class="sub">
      Each answer starts with what Semper does, then a DIC good-practice note. Experiment design is
      covered in the iDICs
      <a href={idics} rel="noopener noreferrer"
        ><em>Good Practices Guide for Digital Image Correlation</em></a
      >.
    </p>

    <div class="faq">
      {
        faqs.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
            <p class="practice">
              <strong>Good practice</strong>
              {item.practice}{' '}
              <a href={idics} rel="noopener noreferrer">
                iDICs guide
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <div class="cta-row" style="margin-top: 1.5rem">
      <a class="btn btn-primary" href={withBase('/community')}>Open Community</a>
      <a class="btn btn-ghost" href={withBase('/support')}>Open Support</a>
    </div>
  </section>
</BaseLayout>
