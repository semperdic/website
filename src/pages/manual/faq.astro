---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/github';

const idics = 'https://idics.org/guide/';

const faqs = [
  {
    q: 'Why did I get a low-texture / weak speckle warning?',
    a: 'On import Semper measures intensity gradients in your reference. Weak pattern triggers a warning and suggests a larger subset. Treat it as a comment on the pattern, not only a slider setting.',
    practice:
      'Good practice (iDICs): aim for a high-contrast, random, well-resolved speckle with enough features inside each subset. Improve paint/lighting before forcing tiny subsets.',
  },
  {
    q: 'Frames are different sizes, or JPEG looks soft — what breaks?',
    a: 'All frames must match the reference pixel size or the run is blocked. JPEG works but Semper warns: compression damages gradients correlation needs. Prefer PNG or TIFF; use Files for RAW/DNG.',
    practice:
      'Good practice (iDICs): keep acquisition settings fixed across the sequence, avoid aggressive compression, and maintain stable lighting so intensity changes are from deformation, not the camera pipeline.',
  },
  {
    q: 'ROI too small, or correlation fails in grips / fiducials?',
    a: 'An ROI smaller than the subset will not run — enlarge the ROI or shrink the subset. Use Erase in the ROI editor to punch out grips and markers that will decorrelate.',
    practice:
      'Good practice (iDICs): correlate only on well-speckled material; exclude regions that rotate out of plane, lose focus, or leave the camera’s field.',
  },
  {
    q: 'The run stopped mid-sequence (“decorrelated”). Is the data lost?',
    a: 'Two consecutive frames below 50% convergence stop the run. Frames solved before that are kept as a short analysis with the stop reason on Home and in Settings used. Re-run after fixing the pair if you need later frames.',
    practice:
      'Good practice (iDICs): large strain, specular glare, or pattern damage between frames causes decorrelation. Reduce step size between loads, improve lighting, or split the test into stages with intermediate references when appropriate.',
  },
  {
    q: 'Strain looks noisy — or peaks look washed out?',
    a: 'Strain comes from differentiating displacement. Raise the strain window (and quote VSG) to smooth noise; lower it to keep local peaks. Use a Sweep to see where curves stop separating.',
    practice:
      'Good practice (iDICs): report the virtual strain gauge size with your strain maps, and show that results are insensitive to reasonable VSG choices (a convergence / sensitivity check).',
  },
  {
    q: 'Are U and V in millimetres?',
    a: 'No. Displacements are in pixels. Semper has no spatial calibration — convert using your own scale factor.',
    practice:
      'Good practice (iDICs): document how you convert pixels to physical units, and keep that scale consistent across the study.',
  },
  {
    q: 'Frames look incomparable in the viewer, or order is wrong?',
    a: 'Auto colour scale rescales each frame alone — set fixed min/max, or use the summary animation (one scale for the sequence). Fix frame order with Sort on step 1 before computing.',
    practice:
      'Good practice (iDICs): compare load steps on a common colour scale when reporting sequences.',
  },
  {
    q: 'Where do I ask for help?',
    a: 'Use the Manual for how-to. For open questions, bugs, and features, go to Community (GitHub login required to post). For account or private data, email support from the app or the Support page.',
    practice:
      'When reporting a DIC issue, include app version, device, image format/resolution, and whether results look wrong (PDF/CSV help triage).',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Common DIC and Semper questions with good-practice notes."
  path="/manual/faq"
>
  <section class="section" style="padding-top: 3rem">
    <p class="crumb">
      <a href={withBase('/manual')}>← Manual</a>
    </p>
    <h2>FAQ</h2>
    <p class="sub">
      Semper-oriented answers first; each item adds a DIC good-practice note. Experiment design is
      covered in depth by the iDICs
      <a href={idics} rel="noopener noreferrer"><em>Good Practices Guide for Digital Image Correlation</em></a>.
    </p>

    <div class="faq">
      {
        faqs.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
            <p class="practice">
              <strong>Good practice</strong>
              {item.practice}{' '}
              <a href={idics} rel="noopener noreferrer">
                iDICs guide
              </a>
            </p>
          </article>
        ))
      }
    </div>

    <div class="cta-row" style="margin-top: 1.5rem">
      <a class="btn btn-primary" href={withBase('/community')}>Community</a>
      <a class="btn btn-ghost" href={withBase('/support')}>Support</a>
    </div>
  </section>
</BaseLayout>
