---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManualPager from '../../components/ManualPager.astro';
import { withBase } from '../../lib/github';

const idics = 'https://idics.org/guide/';

// Conceptual "what / why" questions. In-app Why? chips open the anchored
// entries below (ids must match semperdic-app url_faq_* / FAQ_LINKS.md).
const faqs = [
  {
    q: 'What is Semper for?',
    a: 'It measures how a surface deforms from photographs — full-field displacement and strain maps, computed on your Android phone. It is aimed at mechanical testing and materials work.',
  },
  {
    q: 'Is it free, and do I need an account?',
    a: 'You sign in (Google or email), and a new account needs a one-time admin approval before you can use the app. That gate is about managing access, not payment.',
  },
  {
    q: 'Why does my account need approval?',
    a: 'Semper is an allow-list app while it is in early release. Support is emailed automatically when you sign up; tap Check status in the app after you are approved — it does not update on its own.',
  },
  {
    q: 'Does it work offline?',
    a: 'Yes, once your device has been approved. Importing frames and running the correlation need no network. Only sign-in, approval checks, and cloud uploads do.',
  },
  {
    q: 'Can I use my phone camera, or a video?',
    a: 'You load photos you have already taken, or pick a video and Semper samples it into frames (the first frame becomes the reference). For how to shoot a good speckle and lighting, see the iDICs guide below.',
  },
  {
    q: 'Are results in millimetres?',
    a: 'No. Displacements are in pixels — Semper has no spatial calibration. Convert with your own scale factor (pixels per mm from your setup).',
  },
  {
    q: 'How accurate is it?',
    a: 'The engine locates each subset to roughly 1/100 of a pixel, and recommends a subset size that targets about 0.007 px displacement accuracy on your image. Real accuracy depends on your speckle, lighting, and camera — the parameters and a sweep let you check it.',
  },
  {
    id: 'jpeg-warning',
    q: 'Why does Semper warn about JPEG?',
    a: 'JPEG works, but compression damages the intensity gradients correlation needs, so Semper shows a non-blocking warning. Prefer PNG or TIFF. RAW and DNG import only through Files, not the gallery.',
  },
  {
    id: 'speckle-contrast',
    q: 'Why is speckle contrast too low?',
    a: 'On import the app measures your speckle. A weak pattern cannot reach the target accuracy even at the largest subset, so you see a warning and a larger subset suggestion. Treat it as feedback on the pattern, not just a slider tip: accept the larger subset, redraw the ROI over well-speckled surface, or re-shoot. For how to paint and light a speckle, see the iDICs guide below.',
  },
  {
    q: 'Is my data uploaded to the cloud?',
    a: 'Only if you turn on Save to cloud. The correlation always runs on the phone; cloud backup just stores the results you choose to sync, so you can restore them. See Privacy for the full picture.',
  },
  {
    q: 'Can I use Semper results in a paper?',
    a: 'Yes. Export “Everything”, quote the VSG with any strain value, and keep the archive with your raw images — inputs, fields, and parameters together are what make the result reproducible. From a sweep you can also Save graph for an annotated lattice plot PNG.',
  },
  {
    q: 'I forgot my password — do I leave the app?',
    a: 'No. Forgot password mails a link that reopens Semper on a set-new-password form (same password rules). Email sign-in links work the same way once App Links are verified.',
  },
  {
    q: 'Does Semper send crash reports?',
    a: 'Only if you opt in. After the beta notice on first run you are asked once; you can change it later under Settings → Your data → Send crash reports. Declining is the default. Reports never include your images or results.',
  },
  {
    q: 'How do I reuse parameters from a sweep?',
    a: 'On the lattice plot, double-tap the value readout to copy that combination’s subset, step, and strain window. Start a new single-setting analysis and tap Paste params on step 2.',
  },
  {
    q: 'Something went wrong — where do I look?',
    a: 'The From the app section below covers the messages the app links here. Troubleshooting has the full list keyed by on-screen text. For how-to, use the Manual; for account or private matters, email support.',
  },
];

interface AppFaq {
  id: string;
  q: string;
  a: string;
  moreHref?: string;
  moreLabel?: string;
}

const appFaqs: AppFaq[] = [
  {
    id: 'jpeg-warning',
    q: 'Why the JPEG accuracy warning?',
    a: 'JPEG compression damages the intensity gradients correlation needs. Prefer PNG or TIFF for the reference and deformed frames.',
    moreHref: '/manual/getting-started',
    moreLabel: 'Getting started · images',
  },
  {
    id: 'speckle-contrast',
    q: 'Why the low speckle / contrast warning?',
    a: 'Your pattern is weak for this region — the match may be unreliable. Accept the larger subset Semper suggests, or re-shoot with a finer, higher-contrast speckle.',
    moreHref: '/support/troubleshooting#loading',
    moreLabel: 'Troubleshooting · loading',
  },
  {
    id: 'frame-size-mismatch',
    q: 'Why the frame-size mismatch warning?',
    a: 'Every deformed frame must match the reference’s pixel dimensions exactly. Re-export the odd frame at the same resolution, or drop it.',
    moreHref: '/support/troubleshooting#loading',
    moreLabel: 'Troubleshooting · loading',
  },
  {
    id: 'roi-too-small',
    q: 'Why “ROI too small”?',
    a: 'The region of interest is smaller than a single subset, so nothing can be matched. Enlarge the ROI, or shrink the subset size in Advanced parameters.',
    moreHref: '/manual/analysis',
    moreLabel: 'Manual · region of interest',
  },
  {
    id: 'sweep-subset-range',
    q: 'Why does the sweep say the subset range is too big?',
    a: 'The subset range starts above what this image and ROI can hold. Lower the minimum subset, or draw a larger region of interest.',
    moreHref: '/manual/sweeps-results',
    moreLabel: 'Manual · sweeps',
  },
  {
    id: 'sweep-empty-plan',
    q: 'Why is the sweep plan empty?',
    a: 'No combination fits this ceiling. Raise Max strain window, or lower the subset range, then check the plan again.',
    moreHref: '/manual/sweeps-results',
    moreLabel: 'Manual · sweeps',
  },
  {
    id: 'engine-features',
    q: 'Why did feature detection fail?',
    a: 'The reference and deformed pair could not be correlated at all. Check you paired the right frames, and that the speckle is strong enough over the region.',
    moreHref: '/support/troubleshooting#during-a-run',
    moreLabel: 'Troubleshooting · during a run',
  },
  {
    id: 'engine-roi',
    q: 'Why did the engine fail on the ROI?',
    a: 'The region was too small or fully masked by erased holes. Enlarge the ROI, or remove some of the erased holes.',
    moreHref: '/support/troubleshooting#during-a-run',
    moreLabel: 'Troubleshooting · during a run',
  },
  {
    id: 'engine-init',
    q: 'Why couldn’t the engine start?',
    a: 'An image failed to decode before correlation began. Re-import the frames as PNG or TIFF.',
    moreHref: '/support/troubleshooting#loading',
    moreLabel: 'Troubleshooting · loading',
  },
  {
    id: 'engine-convergence',
    q: 'Why did the run stop for low convergence?',
    a: 'Two frames in a row fell below 50% convergence — the images decorrelated (pattern change, large deformation, or the specimen moved out of view). Frames solved before the stop are kept as a shorter analysis.',
    moreHref: '/support/troubleshooting#during-a-run',
    moreLabel: 'Troubleshooting · during a run',
  },
  {
    id: 'engine-vsg',
    q: 'Why did this sweep combination fail (VSG)?',
    a: 'No strain survived this window at this step, or every lattice node failed for the same family of reasons. Tap a hollow node for its exact reason; enlarge the ROI or narrow the ranges.',
    moreHref: '/manual/sweeps-results',
    moreLabel: 'Manual · result lattice',
  },
  {
    id: 'import-reference',
    q: 'Why did the reference fail to load?',
    a: 'The reference frame could not be opened, or a RAW/DNG file could not be decoded. Prefer PNG or TIFF; import RAW and DNG through Files, not Photos.',
    moreHref: '/support/troubleshooting#loading',
    moreLabel: 'Troubleshooting · loading',
  },
  {
    id: 'import-deformed',
    q: 'Why did the deformed frames fail to load?',
    a: 'The deformed batch could not be opened. Try different files, or convert them to PNG or TIFF and load those.',
    moreHref: '/support/troubleshooting#loading',
    moreLabel: 'Troubleshooting · loading',
  },
  {
    id: 'video-read',
    q: 'Why couldn’t Semper read this video?',
    a: 'The video file could not be opened for sampling. Try a standard MP4, or export the frames as images and load those instead.',
    moreHref: '/support/troubleshooting#loading',
    moreLabel: 'Troubleshooting · loading',
  },
  {
    id: 'video-extract',
    q: 'Why weren’t enough frames extracted from the video?',
    a: 'The time segment and frame rate you chose do not yield enough frames. Widen the segment, raise the sampling frame rate, and watch the live frame-count estimate before confirming.',
    moreHref: '/manual/getting-started',
    moreLabel: 'Getting started · video',
  },
  {
    id: 'no-batch-data',
    q: 'Why “No valid batch data found”?',
    a: 'The result viewer opened without a usable `.dat` batch for this analysis. Re-open the analysis from Home, or re-run if the files were removed from the device.',
    moreHref: '/support/troubleshooting#reading',
    moreLabel: 'Troubleshooting · reading',
  },
  {
    id: 'viewer-oom',
    q: 'Why isn’t there enough memory to open this frame?',
    a: 'Android ran out of memory loading the frame. Close other apps, or open a smaller analysis.',
    moreHref: '/support/troubleshooting#reading',
    moreLabel: 'Troubleshooting · reading',
  },
  {
    id: 'custom-scale',
    q: 'Why are the custom scale inputs invalid?',
    a: 'The colour-scale minimum must be below the maximum. Enter a lower min, a higher max, or clear the fields to return to Auto.',
    moreHref: '/manual/sweeps-results',
    moreLabel: 'Manual · reading results',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Common Semper questions about images, ROI, strain, and support."
  path="/manual/faq"
>
  <section class="section" style="padding-top: 3rem">
    <p class="crumb">
      <a href={withBase('/manual')}>← Manual</a>
    </p>
    <h2>FAQ</h2>
    <p class="sub">
      Short answers to the questions people arrive with. In-app <strong>Why?</strong> chips land on
      the matching heading in <a href="#from-the-app">From the app</a>. The full message list is in
      <a href={withBase('/support/troubleshooting')}>Troubleshooting</a>.
    </p>

    <div class="faq">
      {
        faqs.map((item) => (
          <article class="faq-item">
            <h3 id={item.id}>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>

    <h3 id="from-the-app" class="faq-section-title">From the app</h3>
    <p class="sub">
      Answers for the exact warnings and errors the app can open here. Heading IDs match the app’s
      FAQ links — do not rename them without updating the app strings.
    </p>

    <div class="faq">
      {
        appFaqs.map((item) => (
          <article class="faq-item" id={item.id}>
            <h3>{item.q}</h3>
            <p>{item.a}</p>
            {item.moreHref && item.moreLabel && (
              <p class="faq-more">
                <a href={withBase(item.moreHref)}>{item.moreLabel}</a>
              </p>
            )}
          </article>
        ))
      }
    </div>

    <div class="faq-note">
      <p>
        Speckle, lighting, and experiment design are outside this FAQ. See the iDICs
        <a href={idics} rel="noopener noreferrer"
          ><em>Good Practices Guide for Digital Image Correlation</em></a
        >, or the
        <a href={withBase('/manual')}>Manual</a> and
        <a href={withBase('/learn/dic')}>How DIC works</a>.
      </p>
    </div>

    <p class="sub" style="margin-top: 1.25rem">
      <a href={withBase('/support/troubleshooting')}>Troubleshooting</a>
      ·
      <a href={withBase('/privacy')}>Privacy</a>
      ·
      <a href={withBase('/community')}>Community</a>
      ·
      <a href={withBase('/support')}>Support</a>
    </p>

    <ManualPager prev={{ href: '/manual/exports-manage', label: 'Exports & manage' }} />
  </section>
</BaseLayout>
