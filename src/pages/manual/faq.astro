---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ManualPager from '../../components/ManualPager.astro';
import { withBase } from '../../lib/github';

const idics = 'https://idics.org/guide/';

const faqs = [
  {
    q: 'Why did I get a low-texture / weak speckle warning?',
    a: 'On import, Semper measures intensity gradients in your reference. A weak pattern triggers a warning and suggests a larger subset. Treat that as feedback on the pattern, not only a slider tip.',
  },
  {
    q: 'Frames are different sizes, or JPEG looks soft — what breaks?',
    a: 'All frames must match the reference pixel size or the run is blocked. JPEG works but Semper warns because compression damages gradients. Prefer PNG or TIFF. Use Files for RAW and DNG.',
  },
  {
    q: 'ROI too small, or correlation fails on grips / fiducials?',
    a: 'An ROI smaller than the subset will not run — enlarge the ROI or shrink the subset. Use Erase to punch out grips and markers that will decorrelate.',
  },
  {
    q: 'The run stopped mid-sequence (“decorrelated”). Is the data lost?',
    a: 'Two consecutive frames below 50% convergence stop the run. Frames solved before that are kept, with the stop reason on Home and in Settings used.',
  },
  {
    q: 'Strain looks noisy — or peaks look washed out?',
    a: 'Raise the strain window (and quote VSG) to smooth noise. Lower it to keep local peaks. Use a Sweep to see where curves stop separating.',
  },
  {
    q: 'Are U and V in millimetres?',
    a: 'No. Displacements are in pixels. Semper has no spatial calibration — convert with your own scale factor.',
  },
  {
    q: 'Frames look incomparable in the viewer, or order is wrong?',
    a: 'Auto colour scale rescales each frame alone. Set fixed min/max, or use the summary animation (one scale for the sequence). Fix order with Sort on step 1 before Compute.',
  },
  {
    q: 'Where do I ask for help?',
    a: 'Use the Manual for how-to. Open Community for questions, bugs, and features (GitHub login to post). Use Support email for account or private data. Open Privacy for auth and storage.',
  },
];
---

<BaseLayout
  title="FAQ"
  description="Common Semper questions about images, ROI, strain, and support."
  path="/manual/faq"
>
  <section class="section" style="padding-top: 3rem">
    <p class="crumb">
      <a href={withBase('/manual')}>← Manual</a>
    </p>
    <h2>FAQ</h2>
    <p class="sub">Short answers for common Semper issues.</p>

    <div class="faq">
      {
        faqs.map((item) => (
          <article class="faq-item">
            <h3>{item.q}</h3>
            <p>{item.a}</p>
          </article>
        ))
      }
    </div>

    <div class="faq-note">
      <p>
        Speckle, lighting, and experiment design are outside this FAQ. See the iDICs
        <a href={idics} rel="noopener noreferrer"
          ><em>Good Practices Guide for Digital Image Correlation</em></a
        >, or the
        <a href={withBase('/manual')}>Manual</a> and
        <a href={withBase('/learn/dic')}>How DIC works</a>.
      </p>
    </div>

    <p class="sub" style="margin-top: 1.25rem">
      <a href={withBase('/privacy')}>Privacy</a>
      ·
      <a href={withBase('/community')}>Community</a>
      ·
      <a href={withBase('/support')}>Support</a>
    </p>

    <ManualPager prev={{ href: '/manual/exports-manage', label: 'Exports & manage' }} />
  </section>
</BaseLayout>
