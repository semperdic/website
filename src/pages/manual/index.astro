---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/github';

const chapters = [
  {
    href: '/manual/getting-started',
    title: 'Getting started',
    blurb: 'What Semper computes, signing in, and which images work.',
  },
  {
    href: '/manual/analysis',
    title: 'Running an analysis',
    blurb: 'Load frames, set parameters, draw an ROI, and compute.',
  },
  {
    href: '/manual/sweeps-results',
    title: 'Sweeps & results',
    blurb: 'Parameter sweeps, reading fields, and the result viewer.',
  },
  {
    href: '/manual/exports-manage',
    title: 'Exports & managing analyses',
    blurb: 'PDF, CSV, images, cloud backup, and Settings.',
  },
  {
    href: '/manual/faq',
    title: 'FAQ',
    blurb: 'Common DIC issues — Semper answers plus good-practice notes.',
  },
];
---

<BaseLayout
  title="Manual"
  description="How to run digital image correlation in Semper."
  path="/manual"
>
  <section class="section" style="padding-top: 3rem">
    <h2>Manual</h2>
    <p class="sub">
      Step-by-step use of the app once you have images. For experiment design
      (speckle, lighting, cameras), see the iDICs
      <em>Good Practices Guide for Digital Image Correlation</em>
      —
      <a
        href="https://idics.org/guide/"
        rel="noopener noreferrer">idics.org/guide</a
      >.
    </p>

    <ul class="toc">
      {
        chapters.map((c) => (
          <li>
            <a href={withBase(c.href)}>
              {c.title}
              <span>{c.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="cta-row">
      <a class="btn btn-primary" href={withBase('/manual/getting-started')}>Start here</a>
      <a class="btn btn-ghost" href={withBase('/learn/dic')}>How DIC works</a>
    </div>
  </section>
</BaseLayout>
