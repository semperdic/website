---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { withBase } from '../../lib/github';

const chapters = [
  {
    href: '/manual/getting-started',
    title: 'Getting started',
    blurb: 'What Semper computes, how you sign in, and which images it accepts.',
  },
  {
    href: '/manual/analysis',
    title: 'Running an analysis',
    blurb: 'Load frames, set parameters, draw an ROI, then compute.',
  },
  {
    href: '/manual/sweeps-results',
    title: 'Sweeps & results',
    blurb: 'Parameter sweeps, the result lattice, and reading field maps.',
  },
  {
    href: '/manual/exports-manage',
    title: 'Exports & managing analyses',
    blurb: 'Share PDF, CSV, and images; manage the Home list and Settings.',
  },
  {
    href: '/manual/faq',
    title: 'FAQ',
    blurb: 'Common Semper issues — images, ROI, strain, and where to get help.',
  },
];
---

<BaseLayout
  title="Manual"
  description="How to run digital image correlation in Semper."
  path="/manual"
>
  <section class="section" style="padding-top: 3rem">
    <h2>Manual</h2>
    <p class="sub">
      How to use Semper once you already have images. \n

<small>
      Note: For how to design the
      experiment (speckle, lighting, cameras), use the iDICs
      <em>Good Practices Guide for Digital Image Correlation</em>
      (
      <a href="https://idics.org/guide/" rel="noopener noreferrer">idics.org/guide</a
      >).
</small>
    </p>

    <ul class="toc">
      {
        chapters.map((c) => (
          <li>
            <a href={withBase(c.href)}>
              {c.title}
              <span>{c.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="cta-row">
      <a class="btn btn-primary" href={withBase('/manual/getting-started')}>Open Getting started</a>
      <a class="btn btn-ghost" href={withBase('/learn/dic')}>Open How DIC works</a>
    </div>
  </section>
</BaseLayout>
