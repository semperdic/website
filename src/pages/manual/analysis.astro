---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import { withBase } from '../../lib/github';
---

<BaseLayout
  title="Running an analysis"
  description="Load frames, parameters, ROI, and compute in Semper."
  path="/manual/analysis"
>
  <section class="section" style="padding-top: 3rem">
    <p class="crumb">
      <a href={withBase('/manual')}>← Manual</a>
    </p>
    <h2>Running an analysis</h2>
    <p class="sub">From loading frames through ROI, parameters, and Compute.</p>

    <div class="prose">
      <Figure
        src="/manual/wizard.svg"
        alt="Wizard steps: load frames, settings, optional sweep, then compute"
        caption="Single mode goes straight to Compute; Sweep adds a setup step for ranges."
      />

      <h3>Step 1 — Load frames</h3>
      <p>
        <span class="lead-label">In the app:</span> tap each dropzone and pick images.
        <strong>Photos</strong> is the system picker; <strong>Files</strong> is the only path to RAW
        and DNG.
      </p>
      <Figure
        src="/manual/ui-step1.svg"
        alt="Schematic of Step 1 with reference dropzone and numbered deformed frames"
        caption="Number badges on deformed frames are the analysis order. Use Sort before you continue."
        phone
      />
      <p>
        <span class="lead-label">Why it matters:</span> badge order is the order everywhere
        afterward. You cannot restore the picker&apos;s original order once you sort.
      </p>

      <h3>Step 2 — Settings</h3>
      <ol>
        <li>
          <strong>Region of interest</strong> — defaults to the full image. Edit opens the ROI
          editor.
        </li>
        <li>
          <strong>Single</strong> or <strong>Sweep</strong> — Single solves every frame once. Sweep
          solves one frame across many parameter combinations.
        </li>
        <li><strong>Advanced parameters</strong> — subset, step, strain window, kernel.</li>
      </ol>
      <p>Then tap <strong>Compute</strong>.</p>

      <h3>While it runs</h3>
      <p>
        Points solved and convergence update live. <strong>Cancel</strong> stops at once — nothing
        is kept. Keep the app open; there is no resume if Android kills the process.
      </p>
      <p>
        <span class="lead-label">If it fails:</span> two frames in a row below 50% convergence end
        the run (decorrelation). Frames already solved are kept as a short analysis with the stop
        reason on Home.
      </p>

      <h3>Parameters (single mode)</h3>
      <Figure
        src="/manual/subset-step.svg"
        alt="Diagram of subset window size versus step spacing on a grid"
        caption="Subset is the match window; step is how far apart grid points are."
      />
      <table>
        <thead>
          <tr>
            <th>Parameter</th>
            <th>Range</th>
            <th>Default / reset</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td>Subset size</td>
            <td>15–121, odd</td>
            <td>Recommended from your image</td>
          </tr>
          <tr>
            <td>Step size</td>
            <td>1–30</td>
            <td>5</td>
          </tr>
          <tr>
            <td>Strain window</td>
            <td>5–101, odd</td>
            <td>15</td>
          </tr>
          <tr>
            <td>Kernel</td>
            <td>4×4 Bicubic / 6×6 Keys</td>
            <td>4×4 Bicubic</td>
          </tr>
        </tbody>
      </table>
      <Figure
        src="/manual/vsg.svg"
        alt="Virtual strain gauge related to strain window and step"
        caption="Quote VSG with strain results: VSG = (strain window − 1) × step + 1, in pixels."
      />
      <p>
        Full table: <a href={withBase('/learn/parameters')}>Parameters</a>.
      </p>

      <h3>Region of interest</h3>
      <Figure
        src="/manual/ui-roi.svg"
        alt="Schematic ROI editor with crop rectangle and erase hole"
        caption="Crop sets the area to correlate. Erase punches out grips or markers that would decorrelate."
        phone
      />
      <p>
        <span class="lead-label">If it fails:</span> an ROI smaller than the subset will not run —
        enlarge the ROI or shrink the subset.
      </p>
    </div>

    <div class="cta-row" style="margin-top: 1.5rem">
      <a class="btn btn-primary" href={withBase('/manual/sweeps-results')}>Open Sweeps &amp; results</a>
      <a class="btn btn-ghost" href={withBase('/manual/getting-started')}>Back</a>
    </div>
  </section>
</BaseLayout>
