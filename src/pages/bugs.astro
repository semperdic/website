---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  fetchOpenIssues,
  formatDate,
  issueNewUrl,
  issuesLabelUrl,
} from '../lib/github';

const issues = await fetchOpenIssues('bug', 20);
---

<BaseLayout title="Bugs" description="Open bug reports for Semper." path="/bugs">
  <section class="section" style="padding-top: 3rem">
    <h2>Bugs</h2>
    <p class="sub">Tracked as GitHub Issues labeled <code>bug</code>. GitHub login required to file.</p>
    <div class="cta-row" style="margin-bottom: 1.5rem">
      <a class="btn btn-primary" href={issueNewUrl('bug_report.yml')} rel="noopener noreferrer">
        Report a bug
      </a>
      <a class="btn btn-ghost" href={issuesLabelUrl('bug')} rel="noopener noreferrer">
        All bugs on GitHub
      </a>
    </div>
    {
      issues.length === 0 ? (
        <p class="empty">No open bugs loaded — file one, or browse on GitHub.</p>
      ) : (
        <ul class="list">
          {issues.map((i) => (
            <li>
              <a href={i.html_url} rel="noopener noreferrer">
                <strong>
                  #{i.number} {i.title}
                </strong>
                <span class="meta">
                  {formatDate(i.created_at)}
                  {i.user?.login ? ` · @${i.user.login}` : ''}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
